Gone 项目 Wall 功能增强 - 完整修改总结
📋 修改概述
为 gone 项目的 wall（共享文本编辑区）添加了以下功能：
点击复制功能：选中文字后点击自动复制到剪贴板
响应式宽度：wall textarea 自适应容器宽度，提供更好的编辑体验

📁 修改的文件清单
1. 新增文件
assets/wall-copy.js
用途：实现点击复制功能的外部 JavaScript 文件
功能特性：
只在用户选中文字时才触发复制
支持现代浏览器的 navigator.clipboard API
兼容旧浏览器的 execCommand 降级方案
复制成功后显示顶部绿色提示框（1.5秒后消失）
完整代码：
function initWallCopy() {
  var wallTextarea = document.getElementById('wallContent');
  if (!wallTextarea) return;

  wallTextarea.addEventListener('click', function(e) {
    if (!this.value) return;

    // 检查是否有选中的文字
    var selectedText = this.value.substring(this.selectionStart, this.selectionEnd);

    // 只有在有选中文字时才复制
    if (selectedText) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(selectedText)
          .then(function() {
            showCopyFeedback(wallTextarea, '已复制选中内容');
          })
          .catch(function(err) {
            console.error('Copy failed:', err);
          });
      } else {
        try {
          document.execCommand('copy');
          showCopyFeedback(wallTextarea, '已复制选中内容');
        } catch (err) {
          console.error('Copy failed:', err);
        }
      }
    }
  });
}

function showCopyFeedback(element, message) {
  // 保存原始 title
  var originalTitle = element.title;

  // 显示复制成功提示
  element.title = message;

  // 创建临时提示元素
  var tooltip = document.createElement('div');
  tooltip.textContent = message;
  tooltip.style.cssText = 'position:fixed;top:20px;left:50%;transform:translateX(-50%);background:#4CAF50;color:white;padding:8px 16px;border-radius:4px;font-size:14px;z-index:10000;box-shadow:0 2px 8px rgba(0,0,0,0.2);';
  document.body.appendChild(tooltip);

  // 1.5秒后移除提示并恢复 title
  setTimeout(function() {
    element.title = originalTitle;
    if (tooltip.parentNode) {
      tooltip.parentNode.removeChild(tooltip);
    }
  }, 1500);
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initWallCopy);
} else {
  initWallCopy();
}
