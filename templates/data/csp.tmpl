<!-- csp.tmpl -->
{{ define "csp" -}}
    <meta http-equiv="Content-Security-Policy"
             content="child-src   'none';
                      connect-src 'self';
                      default-src 'none';
                      frame-src   'none';
                      img-src     'self' data: blob:;
                      object-src  'none';
                      script-src  'self';
                      style-src   'self' 'unsafe-inline';">
{{ end }}
